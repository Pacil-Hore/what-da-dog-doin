extends Node

func _ready():
	# Fix AppManager
	var scene = load("res://Scenes/AppManager.tscn")
	var root = scene.instantiate()
	root.main_menu_scene = load("res://Scenes/Menus/MainMenu.tscn")
	root.stage_select_scene = load("res://Scenes/Menus/StageSelect.tscn")
	root.cutscene_a_scene = load("res://Scenes/Cutscenes/CutsceneA.tscn")
	root.cutscene_b_scene = load("res://Scenes/Cutscenes/CutsceneB.tscn")
	root.cutscene_c_scene = load("res://Scenes/Cutscenes/CutsceneC.tscn")
	root.game_manager_scene = load("res://Scenes/GameManager.tscn")
	root.park_boss = load("res://Scenes/park/PlaceholderParkBoss.tscn")
	var park_list: Array[PackedScene] = []
	var park_paths = ["res://Scenes/park/Labyrinth/labyrinth_level.tscn","res://Scenes/park/JumpRope/JumpRopeStage.tscn","res://Scenes/park/PickMe/PickMeStage.tscn","res://Scenes/park/Untangle/UntangleStage.tscn","res://Scenes/park/PlaceholderPark1.tscn","res://Scenes/park/PlaceholderPark2.tscn","res://Scenes/park/PlaceholderPark3.tscn","res://Scenes/park/PlaceholderPark4.tscn"]
	for p in park_paths: park_list.append(load(p))
	root.park_microgames = park_list
	root.street_boss = load("res://Scenes/street/PlaceholderStreetBoss.tscn")
	var street_list: Array[PackedScene] = []
	var street_paths = ["res://Scenes/street/PickTheRope/PickTheRopeStage.tscn","res://Scenes/street/Toilet/ToiletStage.tscn","res://Scenes/street/PlaceholderStreet1.tscn","res://Scenes/street/PlaceholderStreet2.tscn","res://Scenes/street/PlaceholderStreet3.tscn","res://Scenes/street/PlaceholderStreet4.tscn","res://Scenes/street/PlaceholderStreet5.tscn","res://Scenes/street/PlaceholderStreet6.tscn"]
	for p in street_paths: street_list.append(load(p))
	root.street_microgames = street_list
	var packed = PackedScene.new()
	packed.pack(root)
	ResourceSaver.save(packed, "res://Scenes/AppManager.tscn")
	
	# Fix GameManager
	var gm_scene = load("res://Scenes/GameManager.tscn")
	var gm_root = gm_scene.instantiate()
	gm_root.interstitial_scene = load("res://Scenes/Interstitial.tscn")
	var gm_packed = PackedScene.new()
	gm_packed.pack(gm_root)
	ResourceSaver.save(gm_packed, "res://Scenes/GameManager.tscn")
	
	print("All scenes updated successfully")
	get_tree().quit()
